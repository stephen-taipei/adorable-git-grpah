{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/pnpm-lock.yaml"],
    "production": ["default", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/e2e/**/*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "start": {
      "continuous": true
    },
    "dev": {
      "continuous": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": ["build"]
    }
  }
}
