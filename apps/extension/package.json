{
  "name": "@adorable/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "node e2e/run.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@adorable/graph-core": "workspace:*",
    "@adorable/graph-ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
