{
  "name": "adorable-git-graph",
  "private": true,
  "version": "0.1.0",
  "description": "Cartoon-style animated git graph (three.js). Stage 1: Chrome extension for github.com. Stage 2: localhost web app.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run extension:dev",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "e2e": "nx run extension:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "nx": "^23.2.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
